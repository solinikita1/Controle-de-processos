rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    match /projects/{projectId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(projectId);
    }

    match /tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(taskId);
    }

    match /teamMembers/{memberId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(memberId);
    }

    match /backups/{backupId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(backupId);
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
